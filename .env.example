# PostgreSQL connection string (Railway provides DATABASE_URL automatically
# when you add the Postgres plugin to the project).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/amazeon"

# Secret used to sign auth tokens — set a long random value on Railway.
AUTH_SECRET="change-me-on-railway"

# Optional: override the two seeded owner accounts.
# ADMIN1_USER=admin1
# ADMIN1_PASS=admin123
# ADMIN2_USER=admin2
# ADMIN2_PASS=admin123

# Server port (Railway injects PORT automatically).
# PORT=8080
